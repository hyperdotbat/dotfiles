-- Refer to https://wiki.hyprland.org/Configuring/Variables/

-- https://wiki.hyprland.org/Configuring/Variables/--general

hl.config({
    general = {
        gaps_in = 5,
        gaps_out = 20,

        border_size = 4,

        -- https://wiki.hyprland.org/Configuring/Variables/--variable-types for info about colors
        -- col.active_border = rgba(50fa7bff)
        -- col.active_border = rgba(bd93f9ff)
        -- col.active_border = rgba(207,207,220,1) rgba(250,250,255,1) rgba(207,207,220,1) 45deg
        col = {
            border_active = {
                colors = { colors.cyan, colors.green },
                -- angle = 45,
            },

            -- col.inactive_border = rgba(282a36ff)
            -- col.inactive_border = rgba(00000000)
            border_inactive = {
                colors = { colors.bg },
            }
            -- col.inactive_border = rgba(ffffff11) rgba(ffffff55) rgba(ffffff11) 45deg
            -- col.inactive_border = rgba(ffffff55) rgba(ffffff11) rgba(ffffff55) rgba(ffffff11) rgba(ffffff55) 45deg
        },

        -- Set to true enable resizing windows by clicking and dragging on borders and gaps
        resize_on_border = true,


-- See https://wiki.hyprland.org/Configuring/Keywords/
-- Example binds, see https://wiki.hyprland.org/Configuring/Binds/ for more
local mainMod = "SUPER" -- Sets "Windows" key as main modifier
local altMod = "ALT"
-- mainMod = "ALT"
-- altMod = "SUPER" -- replace altMod with "Windows"

hl.bind(mainMod .. " + T", hl.dsp.exec_cmd(terminal))
hl.bind(mainMod .. " + RETURN", hl.dsp.exec_cmd(terminal))
hl.bind("CTRL + " .. altMod .. " + T", hl.dsp.exec_cmd("terminal"))

hl.bind(mainMod .. " + CTRL +" .. altMod .. " + R", hl.dsp.exec_cmd("hyprctl reload"))

-- Rofi main launcher
-- hl.bind(mainMod .. "SHIFT + A", hl.dsp.exec_cmd(scriptsEtcDir .. "rofi-launcher.sh"))
hl.bind(mainMod .. " + S", hl.dsp.exec_cmd(scriptsEtcDir .. "rofi-launcher.sh"))

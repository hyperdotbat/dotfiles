hl.bind(mainMod .. " + A", hl.dsp.exec_cmd(menu))
-- Rofi run
hl.bind(mainMod .. " + R", hl.dsp.exec_cmd(menu .. " run"))
-- Quick terminal scratchpad
hl.bind(mainMod .. " + SHIFT + R", hl.dsp.exec_cmd("kitten quick-access-terminal"))
-- Rofi process killer
hl.bind(mainMod .. " + CTRL + R", hl.dsp.exec_cmd(scriptsEtcDir .. "rofi-killer.sh"))
-- Rofi window picker
hl.bind(mainMod .. " + SPACE", hl.dsp.exec_cmd(menu .. " window"))
-- Rofi SSH picker
hl.bind(mainMod .. " + SHIFT + T", hl.dsp.exec_cmd(scriptsEtcDir .. "rofi-launcher-submenu_ssh.sh"))

-- Logout Menu
hl.bind(mainMod .. " + ESCAPE", hl.dsp.exec_cmd(logoutMenu))
hl.bind(mainMod .. " + CTRL + SHIFT + L", hl.dsp.exec_cmd(logoutMenu))

-- Essentials ig
hl.bind(mainMod .. " + E", hl.dsp.exec_cmd(fileManager))
hl.bind(mainMod .. " + SHIFT + E", hl.dsp.exec_cmd(fileManagerTermOpen))
hl.bind(mainMod .. " + N", hl.dsp.exec_cmd(codeEditorTermOpen))
-- hl.bind(mainMod .. " + Z", hl.dsp.exec_cmd(codeEditor))
-- hl.bind(mainMod .. " + SHIFT + Z, hl.dsp.exec_cmd(codeEditorTermOpen))
hl.bind(mainMod .. " + Z", hl.dsp.exec_cmd(calculator))
-- hl.bind(mainMod .. " + B", hl.dsp.exec_cmd(browser))
hl.bind(mainMod .. " + B", hl.dsp.exec_cmd(browser .. " --new-tab ~/startpage/index.html"))
hl.bind(mainMod .. " + M", hl.dsp.exec_cmd(musicPlayer))
hl.bind(mainMod .. " + SHIFT + M", hl.dsp.exec_cmd(musicPlayerTermOpen))

-- Window / Tiling management
hl.bind(mainMod .. " + Q", hl.dsp.window.close())
-- hl.bind(mainMod .. " + Q", hl.dsp.exec_cmd(scriptsEtcDir .. "kill.sh"))
hl.bind(mainMod .. " + CTRL + SHIFT + Q", hl.dsp.exit())
-- hl.bind(mainMod .. " + G", hl.dsp.layout("rotatesplit")) -- dwindle
hl.bind(mainMod .. " + G", hl.dsp.layout("promote")) -- scrolling
hl.bind(mainMod .. " + SHIFT + mouse:274", hl.dsp.layout("promote")) -- scrolling
hl.bind(mainMod .. " + CTRL + F", hl.dsp.window.pseudo()) -- dwindle
hl.bind(mainMod .. " + F", hl.dsp.window.fullscreen())
hl.bind(mainMod .. " + SHIFT + F", hl.dsp.window.float())

-- Move focus with mainMod + arrow keys
hl.bind(mainMod .. " + left", hl.dsp.focus({ direction = "l" }))
hl.bind(mainMod .. " + right", hl.dsp.focus({ direction = "r" }))
hl.bind(mainMod .. " + up", hl.dsp.focus({ direction = "u" }))
hl.bind(mainMod .. " + down", hl.dsp.focus({ direction = "d" }))
-- VIM motions
hl.bind(mainMod .. " + h", hl.dsp.focus({ direction = "l" }))
hl.bind(mainMod .. " + l", hl.dsp.focus({ direction = "r" }))
hl.bind(mainMod .. " + k", hl.dsp.focus({ direction = "u" }))
hl.bind(mainMod .. " + j", hl.dsp.focus({ direction = "d" }))
-- for scroller layout
hl.bind(mainMod .. " + CTRL + mouse_down", hl.dsp.focus({ direction = "l" }))
hl.bind(mainMod .. " + CTRL + mouse_up", hl.dsp.focus({ direction = "r" }))

-- to make floating windows go on top when focused
---- (I dont even use floating windows lol they are unusable in combination with tiling using keyboard anyways)
hl.bind(mainMod .. " + left", hl.dsp.window.alter_zorder({ mode = "top" }))
hl.bind(mainMod .. " + right", hl.dsp.window.alter_zorder({ mode = "top" }))
hl.bind(mainMod .. " + up", hl.dsp.window.alter_zorder({ mode = "top" }))
hl.bind(mainMod .. " + down", hl.dsp.window.alter_zorder({ mode = "top" }))
-- VIM motions
hl.bind(mainMod .. " + h", hl.dsp.window.alter_zorder({ mode = "top" }))
hl.bind(mainMod .. " + l", hl.dsp.window.alter_zorder({ mode = "top" }))
hl.bind(mainMod .. " + k", hl.dsp.window.alter_zorder({ mode = "top" }))
hl.bind(mainMod .. " + j", hl.dsp.window.alter_zorder({ mode = "top" }))


-- Move window with mainMod + shift + arrow keys
hl.bind(mainMod .. " + SHIFT + left", hl.dsp.window.move({ direction = "l" }))
hl.bind(mainMod .. " + SHIFT + right", hl.dsp.window.move({ direction = "r" }))
hl.bind(mainMod .. " + SHIFT + up", hl.dsp.window.move({ direction = "u" }))
hl.bind(mainMod .. " + SHIFT + down", hl.dsp.window.move( { direction = "d" }))
-- VIM motions
hl.bind(mainMod .. " + SHIFT + h", hl.dsp.window.move({ direction = "l" }))
hl.bind(mainMod .. " + SHIFT + l", hl.dsp.window.move({ direction = "r" }))
hl.bind(mainMod .. " + SHIFT + k", hl.dsp.window.move({ direction = "u" }))
hl.bind(mainMod .. " + SHIFT + j", hl.dsp.window.move({ direction = "d" }))


-- Scale window with mainMod + ctrl + arrow keys
hl.bind(mainMod .. " + CTRL + left", hl.dsp.window.resize({ x = -10, y = 0, relative = true }), { repeating = true })
hl.bind(mainMod .. " + CTRL + right", hl.dsp.window.resize({ x = 10, y = 0, relative = true }), { repeating = true })
hl.bind(mainMod .. " + CTRL + up", hl.dsp.window.resize({ x = 0, y = 10, relative = true }), { repeating = true })
hl.bind(mainMod .. " + CTRL + down", hl.dsp.window.resize({ x = 0, y = -10, relative = true }), { repeating = true })
-- VIM motions
hl.bind(mainMod .. " + CTRL + h", hl.dsp.window.resize({ x = -10, y = 0, relative = true }), { repeating = true })
hl.bind(mainMod .. " + CTRL + l", hl.dsp.window.resize({ x = 10, y = 0, relative = true }), { repeating = true })
hl.bind(mainMod .. " + CTRL + k", hl.dsp.window.resize({ x = 0, y = 10, relative = true }), { repeating = true })
hl.bind(mainMod .. " + CTRL + j", hl.dsp.window.resize({ x = 0, y = -10, relative = true }), { repeating = true })

-- Switch workspaces with mainMod + [0-9]
for i = 1, 9 do
    hl.bind(mainMod .. " + " .. i, hl.dsp.focus({workspace = i}))
end
hl.bind(mainMod .. " + 0", hl.dsp.focus({workspace = 10}))
-- hl.bind(mainMod .. " + TAB", hl.dsp.focus({workspace = "previous"}))
hl.bind(mainMod .. " + TAB", hl.dsp.focus({workspace = "previous_per_monitor"}))

-- Next/prev workspace with Super + pageUp/Down
hl.bind(mainMod .. " + page_up", hl.dsp.focus({workspace = "e+1"}))
hl.bind(mainMod .. " + page_down", hl.dsp.focus({workspace = "e-1"}))
hl.bind(mainMod .. " + SHIFT + page_up", hl.dsp.window.move({ workspace = "e+1", follow = true }))
hl.bind(mainMod .. " + SHIFT + page_down", hl.dsp.window.move({ workspace = "e-1", follow = true }))
hl.bind(mainMod .. " + CTRL + page_up", hl.dsp.window.move({ workspace = "e+1", follow = false }))
hl.bind(mainMod .. " + CTRL + page_down", hl.dsp.window.move({ workspace = "e-1", follow = false }))
-- HOME/END as well because of my 65% kb (I dont wanna hold FN down)
hl.bind(mainMod .. " + HOME", hl.dsp.focus({workspace = "e+1"}))
hl.bind(mainMod .. " + END", hl.dsp.focus({workspace = "e-1"}))
hl.bind(mainMod .. " + SHIFT + HOME", hl.dsp.window.move({ workspace = "e+1", follow = true }))
hl.bind(mainMod .. " + SHIFT + END", hl.dsp.window.move({ workspace = "e-1", follow = true }))
hl.bind(mainMod .. " + CTRL + HOME", hl.dsp.window.move({ workspace = "e+1", follow = false }))
hl.bind(mainMod .. " + CTRL + END", hl.dsp.window.move({ workspace = "e-1", follow = false }))
-- Super + Mouse4&5
hl.bind(mainMod .. " + mouse:276", hl.dsp.focus({workspace = "e+1"}))
hl.bind(mainMod .. " + mouse:275", hl.dsp.focus({workspace = "e-1"}))
hl.bind(mainMod .. " + SHIFT + mouse:276", hl.dsp.window.move({ workspace = "e+1", follow = true }))
hl.bind(mainMod .. " + SHIFT + mouse:275", hl.dsp.window.move({ workspace = "e-1", follow = true }))
hl.bind(mainMod .. " + CTRL + mouse:276", hl.dsp.window.move({ workspace = "e+1", follow = false }))
hl.bind(mainMod .. " + CTRL + mouse:275", hl.dsp.window.move({ workspace = "e-1", follow = false }))
-- Alternatively make it toggle previous
-- hl.bind(mainMod .. " + mouse:275", workspace, previous
-- hl.bind(mainMod .. " + mouse:276", workspace, previous

-- Scroll through existing workspaces with mainMod + scroll
hl.bind(mainMod .. " + mouse_up", hl.dsp.focus({workspace = "e+1"}))
hl.bind(mainMod .. " + mouse_down", hl.dsp.focus({workspace = "e-1"}))
hl.bind(mainMod .. " + SHIFT + mouse_up", hl.dsp.window.move({ workspace = "e+1", follow = true }))
hl.bind(mainMod .. " + SHIFT + mouse_down", hl.dsp.window.move({ workspace = "e-1", follow = true }))
hl.bind(mainMod .. "+" .. altMod .. " + mouse_up", hl.dsp.window.move({ workspace = "e+1", follow = false }))
hl.bind(mainMod .. "+" .. altMod .. " + mouse_down", hl.dsp.window.move({ workspace = "e-1", follow = false }))


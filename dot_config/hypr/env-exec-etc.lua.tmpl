----------------------------------
------ AUTOSTART ------
----------------------------------

-- Power button suspend override
local power_inhibitor_pid = "/tmp/.hyprland-systemd-inhibit"

hl.on("hyprland.start", function()
    hl.exec_cmd(
        'systemd-inhibit ' ..
        '--who="Hyprland config" ' ..
        '--why="power button handled by Hyprland" ' ..
        '--what=handle-power-key ' ..
        '--mode=block ' ..
        'sleep infinity & ' ..
        'echo $! > ' .. power_inhibitor_pid
    )
end)

hl.on("hyprland.shutdown", function()
    hl.exec_cmd(
        'kill -9 "$(cat ' .. power_inhibitor_pid .. ')" 2>/dev/null'
    )
end)

hl.bind(
    "XF86PowerOff",
    hl.dsp.exec_cmd("systemctl suspend")
)


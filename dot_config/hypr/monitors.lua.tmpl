-- See https://wiki.hyprland.org/Configuring/Monitors/

monitorMain = "DP-1"
monitorSecond = "DP-2"

{{- if eq .chezmoi.hostname "hoshizora" }}
hl.monitor({
    output = monitorMain,
    mode = "2560x1440@240",
    position = "0x0",
    scale = 1,
})
-- hl.monitor({
--     output = monitorSecond,
--     mode = "1920x1200@60",
--     position = "1920x-280",
--     scale = 1,
--     transform = 1,
-- })
{{- end }}

{{- if eq .chezmoi.hostname "komorebi" }}
monitorMain="eDP-1"
hl.monitor({
    output = monitorMain,
    mode = "1920x1080@60",
    position = "0x0",
    scale = 1.2,
})
{{- end }}

{{- if eq .chezmoi.hostname "pakku" }}
monitorMain="DSI-1"
hl.monitor({
    output = monitorMain,
    mode = "1920x1200@60",
    position = "0x0",
    scale = 2,
    transform = 3,
})
{{- end }}


{{- $monitorMode := 0 }}
{{- if hasKey . "monitorMode" }}
    {{- if kindIs "map" .monitorMode }}
        {{- $monitorMode = default 0 (index .monitorMode .chezmoi.hostname) }}
    {{- else }}
        {{- $monitorMode = .monitorMode }}
    {{- end }}
{{- end }}

{{- if eq $monitorMode 1 }}
-- Mirror
hl.monitor({
    output = "",
    resolution = "preferred",
    position = "auto",
    scale = 1,
    mirror = monitorMain,
})
{{- end }}

{{- if eq $monitorMode 2 }}
-- External only
hl.monitor({
    output = monitorMain,
    disabled = true,
})
monitorMain = "HDMI-A-2"
hl.monitor({
    output = "",
    resolution = "highrr",
    position = "auto",
    scale = 1,
})
{{- end }}


hl.config({
    misc = {
        -- vrr = 3,
        -- direct_scanout = 2,
        mouse_move_enables_dpms = false,
        key_press_enables_dpms = true,
    }
})
